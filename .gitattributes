# Нормализация переводов строк: в репозитории — LF, при checkout — родные для ОS.
* text=auto

# Shell-скрипты исполняются на Linux/macOS — только LF, даже при checkout в Windows.
*.sh    text eol=lf

# Явные бинарники — никогда не трогать переводы строк.
*.exe   binary
*.EXE   binary
*.ico   binary
*.png   binary
*.woff2 binary
*.zip   binary
*.sys   binary
*.SYS   binary
*.dll   binary
*.DLL   binary
*.cat   binary
*.CAT   binary
*.inf   binary
*.INF   binary
